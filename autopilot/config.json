    ]
  },
  "site": "https://williamssystems.dev",
  "remindMinutes": 30,
  "pollSeconds": 15,
  "claudeMinutes": 45,
  "workRoot": "C:/Users/adapt/.ws-autopilot",
  "projects": {
    "face-mane": [
      {
        "name": "face-and-mane",
        "path": "C:/Users/adapt/OneDrive/Desktop/face-and-mane",
        "base": "feat/jul02-plus-tunnel",
        "check": "npm run build:beta",
        "preview": {
          "build": null,
          "dir": "dist"
        }
      },
      {
        "name": "face-and-mane-api",
        "path": "C:/Users/adapt/OneDrive/Desktop/face-and-mane-api",
        "base": "feat/backend-mvp",
        "check": null
      },
      {
        "name": "face-and-mane-mobile",
        "path": "C:/Users/adapt/OneDrive/Desktop/face-and-mane-mobile",
        "base": "main",
        "pushTo": "autopilot/ticket-{n}",
        "check": "flutter analyze --no-fatal-infos",
        "preview": {
          "build": "flutter build web --release",
          "dir": "build/web"
        }
      }
    ],
    "sales-audit-system": [
      {
        "name": "sales-audit",
        "path": "C:/Users/adapt/sales-audit",
        "base": "main",
        "remote": false,
        "secretFiles": [
          "build/product.json"
        ],
        "check": "npm run build:exe"
      }
    ]
  },
  "release": {
    "face-mane": {
      "how": "uploading the zips (API to AWS first, then the site to cPanel)",
      "manual": true,
      "steps": [
        {
          "label": "mobile web zip",
          "when": [
            "face-and-mane-mobile"
          ],
          "in": "face-and-mane-mobile",
          "run": "flutter build web --release && powershell -NoProfile -Command \"New-Item -ItemType Directory -Force ../fnm-deliverables | Out-Null; Compress-Archive -Force -Path build/web/* -DestinationPath ../fnm-deliverables/fnm-mobile-web.zip\"",
          "copy": {
            "from": "fnm-deliverables",
            "to": "C:/Users/adapt/OneDrive/Desktop/fnm-deliverables"
          }
        },
        {
          "label": "cPanel site zip + API zip",
          "when": [
            "face-and-mane",
            "face-and-mane-api"
          ],
          "in": "face-and-mane",
          "run": "python scripts/make-deliverables.py",
          "copy": {
            "from": "fnm-deliverables",
            "to": "C:/Users/adapt/OneDrive/Desktop/fnm-deliverables"
          }
        }
      ]
    },
    "sales-audit-system": {
      "how": "releasing the update to every Lush Lawn computer (npm run release)",
      "manual": false,
      "steps": [
        {
          "label": "npm run release (new version for every Lush Lawn computer)",
          "before": true,
          "in": "sales-audit",
          "run": "npm run release -- --bump patch --notes \"Autopilot ticket #{n}\""
        }
      ]
    }
  }
}
